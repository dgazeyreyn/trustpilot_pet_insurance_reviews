":"invitation","verificationLevel":"not-verified","hasDachExclusion":false\}\},"title":"If I could give 0 stars I would","likes":0,"source":"Organic","dates":\{"experiencedDate":"2026-08-07T00:00:00.000Z","publishedDate":"2026-08-08T07:42:00.000Z","updatedDate":null,"submittedDate":null\},"report":null,"hasUnhandledReports":false,"consumer":\{"id":"6a76c19498510f547f1341b3","displayName":"Kat","imageUrl":"","numberOfReviews":1,"countryCode":"AU","hasImage":false,"isVerified":false\},"reply":null,"consumersReviewCountOnSameDomain":1,"consumersReviewCountOnSameLocation":null,"productReviews":[],"language":"en","location":null\},\{"id":"6a76572c4a6f0ff9a37c3ffd","filtered":false,"isPending":false,"text":"I was with Fetch for a year, and after just one year, they increased my premium by 44% for no clear reason. I didn\'92t even have a single claim during that time. The only explanation they gave me was that my dog is getting older and that the new rate had been approved by the province.\\n\\nI paid premiums for an entire year, and now it feels like that money was completely wasted. A 44% increase after one claim-free year is extremely disappointing and unreasonable.","rating":1,"labels":\{"merged":null,"verification":\{"isVerified":false,"createdDateTime":"2026-08-08T00:07:40.000Z","reviewSourceName":"Organic","verificationSource":"invitation","verificationLevel":"not-verified","hasDachExclusion":false\}\},"title":"44% Premium Increase After One Claim-Free Year","likes":0,"source":"Organic","dates":\{"experiencedDate":"2026-08-07T00:00:00.000Z","publishedDate":"2026-08-08T00:07:40.000Z","updatedDate":null,"submittedDate":null\},"report":null,"hasUnhandledReports":false,"consumer":\{"id":"69ef7043621914e1844f60d0","displayName":"sahar sh","imageUrl":"https://user-images.trustpilot.com/69ef7043621914e1844f60d0/73x73.png","numberOfReviews":2,"countryCode":"CA","hasImage":true,"isVerified":false\},"reply":null,"consumersReviewCountOnSameDomain":1,"consumersReviewCountOnSame